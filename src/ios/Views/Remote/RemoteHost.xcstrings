    "This host's private key is missing from the Keychain. Replace the key, then add the new public key to the host." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der private Schlüssel dieses Hosts fehlt im Schlüsselbund. Ersetze den Schlüssel und füge dann den neuen öffentlichen Schlüssel auf dem Host hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This host's private key is missing from the Keychain. Replace the key, then add the new public key to the host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta la clave privada de este host en el llavero. Reemplaza la clave y luego añade la nueva clave pública al host."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wala sa Keychain ang private key ng host na ito. Palitan ang key, saka idagdag sa host ang bagong public key."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé privée de cet hôte est absente du trousseau. Remplacez la clé, puis ajoutez la nouvelle clé publique sur l’hôte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privatni ključ ovog hosta nedostaje u privjesku ključeva. Zamijenite ključ, a zatim dodajte novi javni ključ na host."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci privat host ini tidak ada di Rantai Kunci. Ganti kuncinya, lalu tambahkan kunci publik baru ke host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストの秘密鍵がキーチェーンにありません。鍵を置き換えてから、新しい公開鍵をホストに追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트의 개인 키가 키체인에 없습니다. 키를 교체한 다음 새 공개 키를 호스트에 추가하세요."
