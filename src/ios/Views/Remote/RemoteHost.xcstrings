    "Run the command on %@. It installs minis-hostd %@ to ~/.minis/bin after checking its SHA-256, and writes ~/.minis/hostd/config.toml. Then, on the host:" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe den Befehl auf %@ aus. Er installiert minis-hostd %@ nach Prüfung der SHA-256-Prüfsumme in ~/.minis/bin und schreibt ~/.minis/hostd/config.toml. Dann auf dem Host:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run the command on %@. It installs minis-hostd %@ to ~/.minis/bin after checking its SHA-256, and writes ~/.minis/hostd/config.toml. Then, on the host:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta el comando en %@. Instala minis-hostd %@ en ~/.minis/bin tras comprobar su SHA-256 y escribe ~/.minis/hostd/config.toml. Después, en el host:"
          }
        },
        "fil" : {
          "stringUnit" : {
