          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama ialah cara ejen dan sembang merujuk hos: 1–32 huruf, digit, “-” atau “_”. Nama tidak boleh diubah kemudian."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwą agent i czat określają host: od 1 do 32 liter, cyfr, „-” lub „_”. Nie można jej później zmienić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
