    "Changing the address or port clears the trusted host key, so the next connection asks you to trust it again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du Adresse oder Port änderst, wird der vertraute Host-Schlüssel gelöscht, und bei der nächsten Verbindung wirst du erneut gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the address or port clears the trusted host key, so the next connection asks you to trust it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar la dirección o el puerto borra la clave de host de confianza, así que la próxima conexión te pedirá que vuelvas a confiar en ella."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag binago ang address o port, mabubura ang pinagkakatiwalaang host key, kaya hihilingin ulit ng susunod na koneksyon na pagkatiwalaan mo ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier l’adresse ou le port efface la clé d’hôte approuvée ; la prochaine connexion vous demandera de l’approuver à nouveau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promjena adrese ili priključka briše pouzdani ključ hosta, pa će vas sljedeća veza ponovno pitati da mu vjerujete."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengubah alamat atau port menghapus kunci host yang dipercaya, jadi koneksi berikutnya meminta Anda mempercayainya lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アドレスかポートを変更すると信頼済みのホスト鍵が消去され、次回の接続時にもう一度信頼するよう求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주소나 포트를 바꾸면 신뢰한 호스트 키가 지워지고, 다음 연결 때 다시 신뢰할지 묻습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menukar alamat atau port mengosongkan kunci hos yang dipercayai, jadi sambungan seterusnya meminta anda mempercayainya semula."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana adresu lub portu usuwa zaufany klucz hosta, więc przy następnym połączeniu trzeba będzie mu ponownie zaufać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o endereço ou a porta apaga a chave de host confiável, então a próxima conexão pedirá que você confie nela de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbarea adresei sau a portului șterge cheia de gazdă de încredere, așa că la următoarea conexiune vi se va cere din nou să o marcați de încredere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При смене адреса или порта доверенный ключ хоста сбрасывается, и при следующем подключении нужно будет довериться ему снова."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การเปลี่ยนที่อยู่หรือพอร์ตจะล้างคีย์โฮสต์ที่เชื่อถือไว้ การเชื่อมต่อครั้งต่อไปจะขอให้คุณเชื่อถืออีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adresi veya bağlantı noktasını değiştirmek güvenilen ana makine anahtarını siler, bu yüzden sonraki bağlantıda ona yeniden güvenmeniz istenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改地址或端口会清除已信任的主机密钥，下次连接时会再次请你信任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改位址或埠號會清除已信任的主機金鑰，下次連線時會再次請你信任。"
          }
        }
      }
    },
    "Chats bound to this host go back to running tools on this iPhone, and its private key is deleted from the Keychain." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An diesen Host gebundene Chats führen ihre Tools wieder auf diesem iPhone aus, und sein privater Schlüssel wird aus dem Schlüsselbund gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats bound to this host go back to running tools on this iPhone, and its private key is deleted from the Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los chats vinculados a este host vuelven a ejecutar sus herramientas en este iPhone, y su clave privada se elimina del llavero."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Babalik sa pagpapatakbo ng tools sa iPhone na ito ang mga chat na naka-bind sa host na ito, at buburahin sa Keychain ang private key nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les discussions liées à cet hôte exécutent à nouveau leurs outils sur cet iPhone, et sa clé privée est supprimée du trousseau."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razgovori vezani uz ovaj host ponovno pokreću alate na ovom iPhoneu, a njegov privatni ključ briše se iz privjeska ključeva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chat yang terikat ke host ini kembali menjalankan alat di iPhone ini, dan kunci privatnya dihapus dari Rantai Kunci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストに紐付いたチャットは再びこの iPhone でツールを実行するようになり、ホストの秘密鍵はキーチェーンから削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 호스트에 연결된 채팅은 다시 이 iPhone에서 도구를 실행하고, 호스트의 개인 키는 키체인에서 삭제됩니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembang yang terikat pada hos ini kembali menjalankan alat pada iPhone ini, dan kunci peribadinya dipadam daripada Rantai Kunci."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czaty powiązane z tym hostem znów uruchamiają narzędzia na tym iPhonie, a jego klucz prywatny jest usuwany z pęku kluczy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os chats vinculados a este host voltam a executar as ferramentas neste iPhone, e a chave privada dele é apagada do Keychain."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaturile legate de această gazdă vor rula din nou instrumentele pe acest iPhone, iar cheia ei privată este ștearsă din Portchei."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаты, привязанные к этому хосту, снова выполняют инструменты на этом iPhone, а его закрытый ключ удаляется из связки ключей."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แชทที่ผูกกับโฮสต์นี้จะกลับมารันเครื่องมือบน iPhone เครื่องนี้ และคีย์ส่วนตัวของโฮสต์จะถูกลบออกจากพวงกุญแจ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ana makineye bağlı sohbetler araçlarını yeniden bu iPhone'da çalıştırır ve ana makinenin özel anahtarı Anahtar Zinciri'nden silinir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绑定到此主机的聊天将重新在这台 iPhone 上运行工具，并且其私钥会从钥匙串中删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
