          }
        }
      }
    },
    "The name is how the agent and the chat refer to the host: 1–32 letters, digits, “-” or “_”. It cannot be changed later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über den Namen sprechen der Agent und der Chat den Host an: 1–32 Buchstaben, Ziffern, „-“ oder „_“. Er kann später nicht geändert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The name is how the agent and the chat refer to the host: 1–32 letters, digits, “-” or “_”. It cannot be changed later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre es cómo el agente y el chat se refieren al host: de 1 a 32 letras, dígitos, “-” o “_”. No se puede cambiar después."
          }
        },
        "fil" : {
          "stringUnit" : {
