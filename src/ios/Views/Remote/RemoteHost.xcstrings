            "value" : "Kunci hos ini datang daripada %@:%@, tetapi “%@” kini menghala ke %@:%@. Uji sambungan sekali lagi untuk melihat kunci semasa hos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten klucz hosta pochodzi z %@:%@, ale „%@” wskazuje teraz na %@:%@. Przetestuj połączenie ponownie, aby zobaczyć bieżący klucz hosta."
          }
