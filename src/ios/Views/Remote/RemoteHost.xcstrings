    "%@ did not answer within %@. Check that the host is awake and reachable, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat nicht innerhalb von %@ geantwortet. Prüfe, ob der Host eingeschaltet und erreichbar ist, und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ did not answer within %@. Check that the host is awake and reachable, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no respondió en %@. Comprueba que el host está encendido y accesible, y vuelve a intentarlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi sumagot ang %@ sa loob ng %@. Tiyaking naka-on at naaabot ang host, saka subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’a pas répondu en %@. Vérifiez que l’hôte est allumé et joignable, puis réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nije odgovorio unutar %@. Provjerite je li host uključen i dostupan, a zatim pokušajte ponovno."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak menjawab dalam %@. Periksa apakah host menyala dan dapat dijangkau, lalu coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が %@ 以内に応答しませんでした。ホストが起動していて接続できることを確認してから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) %@ 안에 응답하지 않았습니다. 호스트가 켜져 있고 연결 가능한지 확인한 다음 다시 시도하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tidak menjawab dalam %@. Semak bahawa hos dihidupkan dan boleh dicapai, kemudian cuba lagi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie odpowiedział w ciągu %@. Sprawdź, czy host jest włączony i osiągalny, a potem spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não respondeu em %@. Verifique se o host está ligado e acessível e tente de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nu a răspuns în %@. Verificați că gazda este pornită și accesibilă, apoi încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не ответил за %@. Проверьте, что хост включён и доступен, и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ไม่ตอบภายใน %@ ตรวจสอบว่าโฮสต์เปิดอยู่และเชื่อมต่อได้ แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, %@ içinde yanıt vermedi. Ana makinenin açık ve erişilebilir olduğunu denetleyip yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未在 %@ 内响应。请检查主机已开机且可以访问，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 未在 %@ 內回應。請檢查主機已開機且可以連線，然後再試一次。"
          }
        }
      }
    },
