    "Connects, then checks the OS, the login shell, that git is on the login shell's PATH, and that ~/.minis is writable." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindet sich und prüft dann das Betriebssystem, die Login-Shell, ob git im PATH der Login-Shell ist und ob ~/.minis beschreibbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects, then checks the OS, the login shell, that git is on the login shell's PATH, and that ~/.minis is writable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se conecta y comprueba el sistema operativo, la shell de inicio de sesión, que git está en el PATH de esa shell y que se puede escribir en ~/.minis."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kumokonekta, saka sinusuri ang OS, ang login shell, kung nasa PATH ng login shell ang git, at kung puwedeng sulatan ang ~/.minis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se connecte, puis vérifie le système, le shell de connexion, la présence de git dans le PATH de ce shell et que ~/.minis est accessible en écriture."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povezuje se, a zatim provjerava OS, ljusku za prijavu, je li git u PATH-u ljuske za prijavu i može li se pisati u ~/.minis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terhubung, lalu memeriksa OS, shell login, apakah git ada di PATH shell login, dan apakah ~/.minis dapat ditulis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続してから、OS、ログインシェル、ログインシェルの PATH に git があるか、~/.minis に書き込めるかを確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결한 다음 OS, 로그인 셸, 로그인 셸의 PATH에 git이 있는지, ~/.minis에 쓸 수 있는지 확인합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menyambung, kemudian menyemak OS, shell log masuk, sama ada git ada dalam PATH shell log masuk dan sama ada ~/.minis boleh ditulis."
          }
        },
        "pl" : {
