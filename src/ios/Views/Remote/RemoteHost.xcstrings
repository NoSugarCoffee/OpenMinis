    "%@ is not a POSIX shell; commands run with %@ -l instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist keine POSIX-Shell; Befehle laufen stattdessen mit %@ -l."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is not a POSIX shell; commands run with %@ -l instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no es una shell POSIX; los comandos se ejecutan con %@ -l en su lugar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi POSIX shell ang %@; tumatakbo ang mga command gamit ang %@ -l sa halip."
          }
        },
        "fr" : {
          "stringUnit" : {
