    "The login shell failed before printing, so git's PATH could not be checked. Run %@ -lc 'command -v git' on the host to see the error." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Login-Shell ist vor der Ausgabe gescheitert, daher konnte der PATH für git nicht geprüft werden. Führe %@ -lc 'command -v git' auf dem Host aus, um den Fehler zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
