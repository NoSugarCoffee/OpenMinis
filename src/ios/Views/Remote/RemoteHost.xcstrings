    "The Keychain refused to delete the key (OSStatus %@). Unlock the device and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund hat das Löschen des Schlüssels abgelehnt (OSStatus %@). Entsperre das Gerät und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Keychain refused to delete the key (OSStatus %@). Unlock the device and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El llavero no permitió eliminar la clave (OSStatus %@). Desbloquea el dispositivo y vuelve a intentarlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tumanggi ang Keychain na burahin ang key (OSStatus %@). I-unlock ang device at subukan ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le trousseau a refusé de supprimer la clé (OSStatus %@). Déverrouillez l’appareil et réessayez."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privjesak ključeva odbio je izbrisati ključ (OSStatus %@). Otključajte uređaj i pokušajte ponovno."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rantai Kunci menolak menghapus kunci (OSStatus %@). Buka kunci perangkat dan coba lagi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーチェーンが鍵の削除を拒否しました（OSStatus %@）。デバイスのロックを解除して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키체인이 키 삭제를 거부했습니다(OSStatus %@). 기기 잠금을 해제하고 다시 시도하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rantai Kunci enggan memadam kunci (OSStatus %@). Buka kunci peranti dan cuba lagi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pęk kluczy odmówił usunięcia klucza (OSStatus %@). Odblokuj urządzenie i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Keychain recusou apagar a chave (OSStatus %@). Desbloqueie o dispositivo e tente de novo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portchei a refuzat ștergerea cheii (OSStatus %@). Deblocați dispozitivul și încercați din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Связка ключей не позволила удалить ключ (OSStatus %@). Разблокируйте устройство и повторите попытку."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พวงกุญแจปฏิเสธการลบคีย์ (OSStatus %@) ปลดล็อกอุปกรณ์แล้วลองอีกครั้ง"
          }
        },
