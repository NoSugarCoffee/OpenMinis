    "~/.minis could not be created or written. Minis keeps run output in ~/.minis/runs; fix the ownership or permissions of ~/.minis, or free disk space." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis konnte nicht erstellt oder beschrieben werden. Minis speichert die Ausgabe von Befehlen in ~/.minis/runs; korrigiere Eigentümer oder Rechte von ~/.minis oder gib Speicherplatz frei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis could not be created or written. Minis keeps run output in ~/.minis/runs; fix the ownership or permissions of ~/.minis, or free disk space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo crear ni escribir ~/.minis. Minis guarda la salida de los comandos en ~/.minis/runs; corrige el propietario o los permisos de ~/.minis, o libera espacio en disco."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi magawa o masulatan ang ~/.minis. Itinatago ng Minis ang output ng mga command sa ~/.minis/runs; ayusin ang may-ari o permissions ng ~/.minis, o magbakante ng disk space."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de créer ou d’écrire ~/.minis. Minis conserve la sortie des commandes dans ~/.minis/runs ; corrigez le propriétaire ou les autorisations de ~/.minis, ou libérez de l’espace disque."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis nije bilo moguće stvoriti ni u njega pisati. Minis čuva izlaz naredbi u ~/.minis/runs; ispravite vlasnika ili dopuštenja za ~/.minis ili oslobodite prostor na disku."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis tidak dapat dibuat atau ditulis. Minis menyimpan output perintah di ~/.minis/runs; perbaiki pemilik atau izin ~/.minis, atau kosongkan ruang disk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis を作成できないか、書き込めませんでした。Minis はコマンドの出力を ~/.minis/runs に保存します。~/.minis の所有者か権限を修正するか、ディスクの空き容量を増やしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis를 만들거나 쓸 수 없습니다. Minis는 명령 출력을 ~/.minis/runs에 보관합니다. ~/.minis의 소유자나 권한을 고치거나 디스크 공간을 확보하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis tidak dapat dicipta atau ditulis. Minis menyimpan output arahan dalam ~/.minis/runs; betulkan pemilik atau kebenaran ~/.minis, atau kosongkan ruang cakera."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się utworzyć ~/.minis ani w nim zapisać. Minis przechowuje wynik poleceń w ~/.minis/runs; popraw właściciela lub uprawnienia ~/.minis albo zwolnij miejsce na dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível criar ou gravar ~/.minis. O Minis guarda a saída dos comandos em ~/.minis/runs; corrija o dono ou as permissões de ~/.minis ou libere espaço em disco."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis nu a putut fi creat sau scris. Minis păstrează ieșirea comenzilor în ~/.minis/runs; corectați proprietarul sau permisiunile pentru ~/.minis ori eliberați spațiu pe disc."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось создать ~/.minis или записать в него. Minis хранит вывод команд в ~/.minis/runs; исправьте владельца или права доступа ~/.minis или освободите место на диске."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างหรือเขียน ~/.minis ไม่ได้ Minis เก็บผลลัพธ์ของคำสั่งไว้ใน ~/.minis/runs ให้แก้เจ้าของหรือสิทธิ์ของ ~/.minis หรือเพิ่มพื้นที่ดิสก์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.minis oluşturulamadı veya yazılamadı. Minis komut çıktısını ~/.minis/runs içinde tutar; ~/.minis'in sahibini veya izinlerini düzeltin ya da disk alanı açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法创建或写入 ~/.minis。Minis 将命令输出保存在 ~/.minis/runs 中；请修正 ~/.minis 的所有者或权限，或释放磁盘空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法建立或寫入 ~/.minis。Minis 會將指令輸出儲存在 ~/.minis/runs 中；請修正 ~/.minis 的擁有者或權限，或釋放磁碟空間。"
          }
        }
      }
    },
