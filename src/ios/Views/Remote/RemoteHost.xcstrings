    "Creates an Ed25519 key that never leaves this device. Its public key is shown after saving, ready to add to the host." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugt einen Ed25519-Schlüssel, der dieses Gerät nie verlässt. Sein öffentlicher Schlüssel wird nach dem Sichern angezeigt, bereit zum Hinzufügen auf dem Host."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates an Ed25519 key that never leaves this device. Its public key is shown after saving, ready to add to the host."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una clave Ed25519 que nunca sale de este dispositivo. Su clave pública se muestra al guardar, lista para añadirla al host."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagawa ng Ed25519 key na hindi kailanman aalis sa device na ito. Ipapakita ang public key nito pagka-save, handa nang idagdag sa host."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crée une clé Ed25519 qui ne quitte jamais cet appareil. Sa clé publique s’affiche après l’enregistrement, prête à être ajoutée sur l’hôte."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stvara Ed25519 ključ koji nikad ne napušta ovaj uređaj. Njegov javni ključ prikazuje se nakon spremanja, spreman za dodavanje na host."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membuat kunci Ed25519 yang tidak pernah meninggalkan perangkat ini. Kunci publiknya ditampilkan setelah disimpan, siap ditambahkan ke host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスから出ることのない Ed25519 鍵を作成します。保存後に公開鍵が表示されるので、ホストに追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기를 떠나지 않는 Ed25519 키를 만듭니다. 저장한 후 공개 키가 표시되며 바로 호스트에 추가할 수 있습니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mencipta kunci Ed25519 yang tidak pernah meninggalkan peranti ini. Kunci awamnya ditunjukkan selepas disimpan, sedia untuk ditambah pada hos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tworzy klucz Ed25519, który nigdy nie opuszcza tego urządzenia. Jego klucz publiczny pojawi się po zapisaniu, gotowy do dodania na hoście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cria uma chave Ed25519 que nunca sai deste dispositivo. A chave pública aparece depois de salvar, pronta para adicionar ao host."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creează o cheie Ed25519 care nu părăsește niciodată acest dispozitiv. Cheia ei publică apare după salvare, gata de adăugat pe gazdă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создаёт ключ Ed25519, который никогда не покидает это устройство. Его открытый ключ появится после сохранения, готовый для добавления на хост."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างคีย์ Ed25519 ที่ไม่ออกจากอุปกรณ์นี้เลย คีย์สาธารณะจะแสดงหลังบันทึก พร้อมเพิ่มไปยังโฮสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu aygıttan hiç çıkmayan bir Ed25519 anahtarı oluşturur. Ortak anahtarı kaydettikten sonra gösterilir ve ana makineye eklenmeye hazırdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "创建一个永远不会离开此设备的 Ed25519 密钥。保存后会显示其公钥，可直接添加到主机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建立一把永遠不會離開此裝置的 Ed25519 金鑰。儲存後會顯示其公開金鑰，可直接加入主機。"
          }
        }
      }
    },
