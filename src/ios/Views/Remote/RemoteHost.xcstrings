        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Această cheie de gazdă provine de la %@:%@, dar „%@” indică acum spre %@:%@. Testați din nou conexiunea pentru a vedea cheia actuală a gazdei."
