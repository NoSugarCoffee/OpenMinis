            "value" : "O nome é como o agente e o chat se referem ao host: de 1 a 32 letras, números, “-” ou “_”. Ele não pode ser alterado depois."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numele este modul în care agentul și chatul se referă la gazdă: 1–32 de litere, cifre, „-” sau „_”. Nu poate fi schimbat ulterior."
          }
