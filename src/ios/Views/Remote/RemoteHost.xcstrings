        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo leer la lista de hosts remotos, así que las herramientas de shell y de archivos están bloqueadas. Abre Ajustes → Hosts remotos para restablecerla."
