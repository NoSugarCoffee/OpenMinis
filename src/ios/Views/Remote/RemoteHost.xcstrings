    "git was not found on the PATH of the login shell (%@ -l). Install git, or add its directory to PATH in that shell's login profile." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git wurde im PATH der Login-Shell (%@ -l) nicht gefunden. Installiere git oder füge sein Verzeichnis im Login-Profil dieser Shell zum PATH hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git was not found on the PATH of the login shell (%@ -l). Install git, or add its directory to PATH in that shell's login profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró git en el PATH de la shell de inicio de sesión (%@ -l). Instala git o añade su directorio al PATH en el perfil de inicio de sesión de esa shell."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi nakita ang git sa PATH ng login shell (%@ -l). I-install ang git, o idagdag ang folder nito sa PATH sa login profile ng shell na iyon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git est introuvable dans le PATH du shell de connexion (%@ -l). Installez git ou ajoutez son dossier au PATH dans le profil de connexion de ce shell."
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git nije pronađen u PATH-u ljuske za prijavu (%@ -l). Instalirajte git ili dodajte njegovu mapu u PATH u profilu za prijavu te ljuske."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git tidak ditemukan di PATH shell login (%@ -l). Instal git, atau tambahkan foldernya ke PATH di profil login shell tersebut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログインシェル（%@ -l）の PATH に git が見つかりませんでした。git をインストールするか、そのシェルのログインプロファイルで git のディレクトリを PATH に追加してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 셸(%@ -l)의 PATH에서 git을 찾지 못했습니다. git을 설치하거나 해당 셸의 로그인 프로필에서 git 디렉터리를 PATH에 추가하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git tidak ditemui dalam PATH shell log masuk (%@ -l). Pasang git, atau tambah foldernya ke PATH dalam profil log masuk shell itu."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie znaleziono git w PATH powłoki logowania (%@ -l). Zainstaluj git lub dodaj jego katalog do PATH w profilu logowania tej powłoki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O git não foi encontrado no PATH do shell de login (%@ -l). Instale o git ou adicione a pasta dele ao PATH no perfil de login desse shell."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git nu a fost găsit în PATH-ul shellului de autentificare (%@ -l). Instalați git sau adăugați dosarul său în PATH în profilul de autentificare al acelui shell."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git не найден в PATH оболочки входа (%@ -l). Установите git или добавьте его каталог в PATH в профиле входа этой оболочки."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่พบ git ใน PATH ของเชลล์ล็อกอิน (%@ -l) ให้ติดตั้ง git หรือเพิ่มไดเรกทอรีของ git ลงใน PATH ในโปรไฟล์ล็อกอินของเชลล์นั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git, oturum açma kabuğunun PATH'inde (%@ -l) bulunamadı. git'i yükleyin veya dizinini o kabuğun oturum açma profilinde PATH'e ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在登录 Shell（%@ -l）的 PATH 中找不到 git。请安装 git，或在该 Shell 的登录配置文件中将其目录添加到 PATH。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在登入 Shell（%@ -l）的 PATH 中找不到 git。請安裝 git，或在該 Shell 的登入設定檔中將其目錄加入 PATH。"
          }
        }
      }
    },
