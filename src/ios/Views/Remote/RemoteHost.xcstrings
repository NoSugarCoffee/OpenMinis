        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunci peribadi hos ini tiada dalam Rantai Kunci. Gantikan kunci, kemudian tambah kunci awam baharu pada hos."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pęku kluczy brakuje klucza prywatnego tego hosta. Zastąp klucz, a potem dodaj nowy klucz publiczny na hoście."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave privada deste host não está no Keychain. Substitua a chave e depois adicione a nova chave pública ao host."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cheia privată a acestei gazde lipsește din Portchei. Înlocuiți cheia, apoi adăugați noua cheie publică pe gazdă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытого ключа этого хоста нет в связке ключей. Замените ключ, затем добавьте новый открытый ключ на хост."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีคีย์ส่วนตัวของโฮสต์นี้ในพวงกุญแจ ให้แทนที่คีย์ แล้วเพิ่มคีย์สาธารณะใหม่ไปยังโฮสต์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ana makinenin özel anahtarı Anahtar Zinciri'nde yok. Anahtarı değiştirin, ardından yeni ortak anahtarı ana makineye ekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "钥匙串中缺少此主机的私钥。请替换密钥，然后将新公钥添加到主机。"
          }
        },
